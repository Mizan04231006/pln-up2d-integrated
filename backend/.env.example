# Salin file ini menjadi ".env" (di dalam folder backend/), lalu isi dengan API key Groq Anda.
# Dapatkan API key GRATIS (tanpa kartu kredit) di: https://console.groq.com/keys
#
# JANGAN commit file ".env" ke Git — sudah dimasukkan ke .gitignore.

GROQ_API_KEY=tempel_api_key_groq_anda_di_sini

# Daftar origin yang diizinkan (CORS), dipisahkan koma. Bila dikosongkan:
#   dev  -> http://localhost:5173, http://127.0.0.1:5173
#   prod -> frontend & API satu origin Vercel (tidak butuh CORS lintas-origin)
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Opsional — ganti model default jika perlu (llama-3.3-70b-versatile direkomendasikan:
# kuota gratis paling seimbang & mendukung tool calling dengan baik)
GROQ_MODEL=openai/gpt-oss-120b
